{
	// Il resto della configurazione lo genera @astrojs/cloudflare in build.
	"name": "yanks-redesign",
	"compatibility_date": "2026-09-23",
	// Espliciti per togliere gli avvisi del deploy: sito su workers.dev e
	// indirizzi di anteprima per ogni versione
	"workers_dev": true,
	"preview_urls": true,
	// Database dello shop (docs/06). Schema in migrations/, seed da merch.ts:
	// npm run db:migrate:local e db:seed:local (e :remote). L'id non è un segreto
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "yanks-db",
			"database_id": "d8a5c25d-5841-454f-b616-243665b0c657"
		}
	]
}
