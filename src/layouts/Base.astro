---
// Layout comune a tutte le pagine: lingua, meta, hreflang, Open Graph, tema.
import { getImage } from 'astro:assets';
import '../styles/global.css';
import esterno from '../assets/home/esterno.jpg';
import { venue } from '../data/venue';
import { defaultLang, locales, type Lang } from '../i18n/locales';
import { t } from '../i18n/t';
import { INDEXABLE, localBusiness } from '../lib/seo';
import themeInit from '../scripts/theme-init.js?raw';
import AgeGate from '../components/site/AgeGate.astro';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import Interactions from '../components/site/Interactions.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  // pagine interne (styleguide): non indicizzate, senza link alle altre lingue
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;

// Stessa pagina nelle altre lingue: cambia solo il primo segmento (/en/… → /nl/…)
const urlFor = (l: Lang) => new URL(Astro.url.pathname.replace(/^\/[^/]+\//, `/${l}/`), Astro.site).href;

// Anteprima quando si condivide un link (Open Graph): il locale dal Dorpsplein,
// 1200×630 come chiedono Facebook, WhatsApp e LinkedIn. getImage ritaglia in build
const ogImage = await getImage({ src: esterno, width: 1200, height: 630, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogLocale: Record<Lang, string> = { nl: 'nl_NL', en: 'en_GB', de: 'de_DE' };
// Dati del locale per i motori di ricerca (lib/seo.ts): solo nella home di ogni lingua
const isHome = Astro.url.pathname === `/${lang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          {/* Indicizzazione spenta finché il locale non approva (lib/seo.ts, INDEXABLE) */}
          {!INDEXABLE && <meta name="robots" content="noindex" />}
          <link rel="canonical" href={urlFor(lang)} />
          {locales.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)}
          <link rel="alternate" hreflang="x-default" href={urlFor(defaultLang)} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={venue.name} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={urlFor(lang)} />
          <meta property="og:locale" content={ogLocale[lang]} />
          {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t(lang, 'home.exterior.alt')} />
          <meta name="twitter:card" content="summary_large_image" />
          {isHome && <script type="application/ld+json" set:html={JSON.stringify(localBusiness(urlFor(lang), ogImageUrl))} />}
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/martian-mono/martian-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <Header lang={lang} />
    <slot />
    <Footer lang={lang} />
    <AgeGate lang={lang} />
    <Interactions lang={lang} />
  </body>
</html>
