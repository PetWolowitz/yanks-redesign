---
// Footer (docs/02): indirizzo, orari, pagine, lingue, social veri, disclaimer del concept.
// Riordinato il 2026-10-01: ogni colonna ha la stessa forma (titolo, poi elenco) e la
// stessa spaziatura. Desktop: cinque colonne su 12; tablet: due; mobile: una.
import { pages } from '../../data/pages';
import { venue } from '../../data/venue';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';
import Hours from './Hours.astro';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';
import ScatterText from './ScatterText.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { street, postalCode, city } = venue.address;
const headingClass = 'mb-3 text-h3';
const linkClass = 'scatter-host inline-block py-1';
---

<footer class="edge-shadow mt-16 border-t-3 border-text bg-surface">
  <div class="mx-auto grid max-w-360 gap-x-8 gap-y-10 px-page pt-14 pb-10 sm:grid-cols-2 lg:grid-cols-12">
    <div class="flex items-start gap-5 sm:col-span-2 lg:col-span-2 lg:flex-col">
      <Logo alt={venue.name} variant="badge" size={160} class="size-28 lg:size-40" />
      <div>
        <h2 class={headingClass}>{t(lang, 'footer.address')}</h2>
        <address class="not-italic">
          {venue.name}<br />
          {street}<br />
          {postalCode} {city}
        </address>
      </div>
    </div>

    <div class="lg:col-span-4">
      <h2 class={headingClass}>{t(lang, 'hours.title')}</h2>
      <Hours lang={lang} />
    </div>

    <nav aria-label={t(lang, 'footer.pages')} class="lg:col-span-2">
      <h2 class={headingClass}>{t(lang, 'footer.pages')}</h2>
      <ul class="space-y-1">
        {
          pages.map(({ slug, key }) => (
            <li>
              <a href={`/${lang}/${slug}/`} class={linkClass}>
                <ScatterText text={t(lang, key)} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-2">
      <h2 class={headingClass}>{t(lang, 'nav.languages')}</h2>
      <LangSwitch lang={lang} scatter dense />
    </div>

    <div class="lg:col-span-2">
      <h2 class={headingClass}>{t(lang, 'footer.follow')}</h2>
      <ul class="space-y-1">
        <li><a href={venue.social.instagram} rel="noopener" class={linkClass}><ScatterText text="Instagram" /></a></li>
        <li><a href={venue.social.facebook} rel="noopener" class={linkClass}><ScatterText text="Facebook" /></a></li>
      </ul>
    </div>

    <div class="border-t-2 border-text pt-6 sm:col-span-2 lg:col-span-12">
      <p class="max-w-[70ch] font-prose text-small text-muted">{t(lang, 'footer.disclaimer')}</p>
    </div>
  </div>
</footer>
