---
// Footer (docs/02): indirizzo, orari, pagine, lingue, social veri, disclaimer del concept.
// Riordinato il 2026-10-01: ogni colonna ha la stessa forma (titolo, poi elenco) e la
// stessa spaziatura. Mobile: una colonna; tablet: due; laptop piccolo (lg): logo e
// indirizzo affiancati sopra, poi quattro colonne; da 1280 px (xl) tutto su una riga.
import { pages } from '../../data/pages';
import { venue } from '../../data/venue';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';
import Hours from './Hours.astro';
import LangSwitch from './LangSwitch.astro';
import SocialIcon from './SocialIcon.astro';
import Logo from './Logo.astro';
import ScatterText from './ScatterText.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { street, postalCode, city } = venue.address;
const headingClass = 'mb-3 text-h3';
// py-2.5 su telefono e tablet: bersagli di tocco di circa 44 px
const linkClass = 'scatter-host inline-block py-2.5 lg:py-1';
---

<footer class="wave-top tone-cream">
  <!-- text-small: testi più piccoli (Pietro, 2026-10-02); i titoli restano text-h3 -->
  <div class="mx-auto grid max-w-360 gap-x-8 gap-y-10 px-page pt-14 pb-10 text-small sm:grid-cols-2 lg:grid-cols-5 xl:grid-cols-12">
    <div class="flex items-start gap-5 sm:col-span-2 lg:col-span-5 xl:col-span-3 xl:flex-col">
      <Logo alt={venue.name} variant="badge" size={160} class="size-28 lg:size-40" />
      <div>
        <h2 class={headingClass}>{t(lang, 'footer.address')}</h2>
        <address class="not-italic">
          {venue.name}<br />
          {street}<br />
          {postalCode} {city}
        </address>
      </div>
    </div>

    <div class="lg:col-span-2 xl:col-span-3">
      <h2 class={headingClass}>{t(lang, 'hours.title')}</h2>
      <Hours lang={lang} />
    </div>

    <nav aria-label={t(lang, 'footer.pages')} class="xl:col-span-2">
      <h2 class={headingClass}>{t(lang, 'footer.pages')}</h2>
      <ul class="space-y-1">
        {
          pages.map(({ slug, key }) => (
            <li>
              <a href={`/${lang}/${slug}/`} class={linkClass}>
                <ScatterText text={t(lang, key)} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Su telefono lingue e social stanno sulla stessa riga, per scorrere meno
         (Pietro, 2026-10-22); da 640 px il contenitore sparisce e restano due colonne -->
    <div class="grid grid-cols-2 gap-x-8 sm:contents">
      <div class="xl:col-span-2">
        <h2 class={headingClass}>{t(lang, 'nav.languages')}</h2>
        <LangSwitch lang={lang} class="-ml-1.5" />
      </div>

      <div class="xl:col-span-2">
        <h2 class={headingClass}>{t(lang, 'footer.follow')}</h2>
        <!-- Icone nostre al posto delle scritte (variante C): il nome resta per i lettori di schermo -->
        <ul class="-ml-2 flex gap-1">
          <li>
            <a href={venue.social.instagram} rel="noopener" title="Instagram" class="grid size-12 place-items-center rounded-full transition-colors hover:text-red-text">
              <SocialIcon name="instagram" class="size-8" />
              <span class="sr-only">Instagram</span>
            </a>
          </li>
          <li>
            <a href={venue.social.facebook} rel="noopener" title="Facebook" class="grid size-12 place-items-center rounded-full transition-colors hover:text-red-text">
              <SocialIcon name="facebook" class="size-8" />
              <span class="sr-only">Facebook</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-4 border-t-[1.5px] border-text pt-6 sm:col-span-2 lg:col-span-5 lg:flex-row lg:justify-between xl:col-span-12">
      <p class="max-w-[70ch] font-prose text-small text-muted">{t(lang, 'footer.disclaimer')}</p>
      <a href={`/${lang}/legal/`} class={`${linkClass} shrink-0 self-start`}>
        <ScatterText text={t(lang, 'legal.link')} />
      </a>
    </div>
  </div>
</footer>
