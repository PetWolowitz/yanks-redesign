---
// Contenuto di terze parti (Google Maps, Instagram) caricato solo al clic
// (CLAUDE.md, Privacy): prima c'è un'anteprima statica con un pulsante e un
// link diretto, così nessun cookie di Google o Meta arriva senza una scelta.
// Senza JS resta il link. L'iframe va autorizzato in frame-src (public/_headers).
interface Props {
  src: string;
  // titolo dell'iframe, per gli screen reader
  title: string;
  buttonLabel: string;
  notice: string;
  linkHref: string;
  linkLabel: string;
  // proporzione del riquadro, per esempio "16 / 9" o "9 / 16"
  ratio?: string;
  // angoli dritti: la mappa di Google, una volta caricata, sborderebbe dagli angoli
  // arrotondati. È l'unica eccezione alla regola degli angoli tondi (docs/02)
  square?: boolean;
  class?: string;
}

const { src, title, buttonLabel, notice, linkHref, linkLabel, ratio = '16 / 9', square = false, class: className } = Astro.props;
---

<click-to-load
  data-src={src}
  data-title={title}
  class:list={['relative block border-3 border-text bg-surface', !square && 'rounded-2xl', className]}
  style={`aspect-ratio: ${ratio}`}
>
  <!-- min-h-full: se il testo è più alto della proporzione (telefoni stretti) il riquadro si allunga invece di farlo uscire -->
  <div data-preview class="flex min-h-full flex-col items-start justify-end gap-3 p-4">
    <slot />
    <p class="max-w-[45ch] text-small text-muted">{notice}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <button type="button" hidden class="min-h-11 border-3 rounded-full border-text px-4 py-2 uppercase hover:bg-text hover:text-bg">
        {buttonLabel}
      </button>
      <a href={linkHref} rel="noopener" class="inline-block py-2 underline underline-offset-4">{linkLabel}</a>
    </div>
  </div>
</click-to-load>

<script>
  class ClickToLoad extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('button');
      if (!button) return;
      // Il pulsante serve solo con JS: senza, resta il link diretto
      button.hidden = false;
      button.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = this.dataset.src ?? '';
        iframe.title = this.dataset.title ?? '';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.className = 'absolute inset-0 size-full border-0';
        iframe.allowFullscreen = true;
        this.querySelector('[data-preview]')?.remove();
        this.append(iframe);
        iframe.focus();
      });
    }
  }

  customElements.define('click-to-load', ClickToLoad);
</script>
