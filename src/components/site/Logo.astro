---
// Il logo (docs/02, Il marchio): il timbro con "Yanks", l'indiano, l'anello aperto e
// le onde, deciso da Pietro il 2026-10-01. SVG da brand/sorgente/logo1-timbro.png.
// - badge: logo completo, dai 160 px in su (hero, footer, avviso d'età, scelta lingua)
// - indiano: solo il volto, sotto i 160 px (header) e come favicon
// Ogni versione ha la variante per il tema chiaro (disco nero) e per lo scuro (con un
// anello crema che stacca il disco dal fondo): si mostra quella del tema attivo.
import badgeChiaro from '../../assets/brand/yanks-badge-chiaro.svg?url';
import badgeScuro from '../../assets/brand/yanks-badge-scuro.svg?url';
import indianoChiaro from '../../assets/brand/yanks-indiano-chiaro.svg?url';
import indianoScuro from '../../assets/brand/yanks-indiano-scuro.svg?url';

interface Props {
  alt: string;
  variant: 'badge' | 'indiano';
  // larghezza mostrata, in px CSS
  size: number;
  class?: string;
  priority?: boolean;
}

const { alt, variant, size, class: className, priority = false } = Astro.props;
const [light, dark] = variant === 'badge' ? [badgeChiaro, badgeScuro] : [indianoChiaro, indianoScuro];
const common = { width: size, height: size, decoding: 'async' as const, fetchpriority: priority ? ('high' as const) : ('auto' as const), loading: priority ? ('eager' as const) : ('lazy' as const) };
---

<span class:list={['inline-block shrink-0', className]}>
  <img src={light} alt={alt} {...common} class="size-full dark:hidden" />
  <img src={dark} alt={alt} {...common} class="hidden size-full dark:block" />
</span>
