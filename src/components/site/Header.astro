---
// Header (docs/02, Navigazione).
// In cima alla pagina è una fascia piatta col bordo sotto; appena si scorre il fondo
// sparisce e compare una capsula staccata dai bordi (solo opacity e transform).
// Desktop: logo, pagine, orologio, lingue e tema, carrello sulla stessa riga.
// Sotto 1024 px: logo, orologio, carrello e ☰; il resto nel menu a tutto schermo
// (popover: funziona senza JS).
// Carrello: l'icona è un link alla pagina carrello; con JS apre il pannello laterale
// (<dialog>). Su carrello e checkout il pannello non c'è: la pagina mostra già tutto.
import { pages } from '../../data/pages';
import CartView from '../shop/CartView.astro';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';
import Hours from './Hours.astro';
import LangSwitch from './LangSwitch.astro';
import Logo from './Logo.astro';
import OpenStatus from './OpenStatus.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const withDrawer = !/\/shop\/(cart|checkout)\//.test(Astro.url.pathname);
const isCurrent = (slug: string) => Astro.url.pathname.startsWith(`/${lang}/${slug}/`);
// Lingue e tema in un'unica pillola, uguale nella fascia e nel menu
const toolsClass = 'items-center gap-0.5 rounded-full border-2 border-text p-0.5';
const iconButton = 'inline-flex size-11 items-center justify-center rounded-full hover:text-red-text';
---

<a
  href="#content"
  class="sr-only z-50 bg-text px-4 py-2 text-bg focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >{t(lang, 'header.skip')}</a
>

<header data-header class="group/header sticky top-0 z-40">
  <!-- Fondo della fascia: c'è in cima alla pagina, sparisce scorrendo -->
  <div
    aria-hidden="true"
    class="absolute inset-0 border-b-3 border-text bg-bg transition-opacity duration-500 group-data-scrolled/header:opacity-0 motion-reduce:transition-none"
  >
  </div>

  <div class="relative mx-auto flex h-16 max-w-360 items-center px-page sm:gap-x-2 lg:h-18 lg:gap-x-1.5 xl:gap-x-5">
    <!-- La capsula: compare scorrendo, un poco più larga del contenuto -->
    <div
      aria-hidden="true"
      class="capsule pointer-events-none absolute inset-y-1.5 rounded-full border-2 border-text bg-surface transition-[opacity,transform] duration-500 motion-reduce:transition-none"
    >
    </div>

    <a href={`/${lang}/`} class="relative me-auto inline-flex h-16 shrink-0 items-center lg:me-0 lg:h-18">
      <Logo
        alt={t(lang, 'header.home')}
        variant="indiano"
        size={56}
        priority
        class="size-12 origin-left transition-transform duration-300 group-data-scrolled/header:scale-80 motion-reduce:transition-none lg:size-12 xl:size-14"
      />
      <!-- Il nome accanto al logo su telefono e tablet (Pietro, 2026-10-26: senza è anonimo);
           sotto i 360 px non ci sta (in tedesco il menu uscirebbe dallo schermo).
           aria-hidden: il nome del link è già nell'alt del logo -->
      <span aria-hidden="true" class="ms-2 pt-1 font-script text-[1.5rem] leading-none text-red-text max-[359px]:hidden origin-left transition-[translate,scale] duration-300 group-data-scrolled/header:-translate-x-2.5 group-data-scrolled/header:scale-85 motion-reduce:transition-none lg:hidden">
        {t(lang, 'header.wordmark')}
      </span>
    </a>

    <nav aria-label={t(lang, 'nav.label')} class="relative hidden flex-1 lg:block">
      <ul class="nav-list flex items-center text-small whitespace-nowrap uppercase xl:gap-1">
        {
          pages.map(({ slug, key }) => (
            <li>
              <a
                href={`/${lang}/${slug}/`}
                aria-current={isCurrent(slug) ? 'page' : undefined}
                class="nav-link inline-flex min-h-10 items-center rounded-full px-2 xl:px-3.5"
              >
                {t(lang, key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <OpenStatus lang={lang} compact class="relative text-xs sm:text-small lg:max-xl:text-xs" />

    <div class:list={['relative hidden text-small lg:inline-flex', toolsClass]}>
      <LangSwitch lang={lang} short />
      <ThemeToggle lang={lang} class="rounded-full hover:text-red-text lg:size-9" />
    </div>
    <!-- Sotto i 1024 px il tema si cambia anche dalla barra, non solo dal menu
         (CLAUDE.md: interruttore sempre in header; Pietro, 2026-10-29). Solo da
         420 px: sotto, con "GEÖFFNET" in tedesco, spingerebbe l'hamburger fuori
         dalla barra, e resta solo nel menu -->
    <span class="hidden min-[420px]:contents lg:hidden">
      <ThemeToggle lang={lang} class="relative shrink-0 rounded-full hover:text-red-text" />
    </span>

    <a href={`/${lang}/shop/cart/`} data-cart-link class:list={['relative shrink-0', iconButton]}>
      <span class="sr-only">{t(lang, 'header.cart')}</span>
      <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 8h14l-1.2 13H6.2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        <path d="M9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="2"></path>
      </svg>
      <!-- Il numero degli articoli lo scrive lo script qui sotto (lib/shop/cart.ts) -->
      <span
        data-cart-count
        hidden
        class="absolute top-0.5 right-0 grid h-5 min-w-5 place-items-center rounded-full bg-red-text px-1 text-xs text-bg"
      ></span>
    </a>

    <button type="button" popovertarget="site-menu" class:list={['relative shrink-0 lg:hidden', iconButton]}>
      <span class="sr-only">{t(lang, 'nav.open')}</span>
      <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 7h18M3 12h18M3 17h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Menu a tutto schermo sotto 1024 px. popover: Esc e il pulsante ✕ lo chiudono, senza JS -->
<div
  id="site-menu"
  popover
  class="site-menu m-0 h-svh max-h-none w-full max-w-none overflow-y-auto border-0 bg-bg p-0 text-text lg:hidden"
>
  <div class="flex min-h-full flex-col px-page pb-[clamp(1rem,4svh,2rem)]">
    <div class="flex h-16 shrink-0 items-center justify-between">
      <a href={`/${lang}/`} class="inline-flex items-center">
        <Logo alt={t(lang, 'header.home')} variant="indiano" size={56} class="size-12" />
        <span aria-hidden="true" class="ms-2 pt-1 font-script text-[1.5rem] leading-none text-red-text">{t(lang, 'header.wordmark')}</span>
      </a>
      <!-- Il tema accanto alla ✕, in vista appena si apre il menu (Pietro, 2026-10-29):
           sotto i 420 px nella barra non ci sta -->
      <div class="flex items-center gap-2">
        <ThemeToggle lang={lang} class="rounded-full hover:text-red-text" />
        <button type="button" popovertarget="site-menu" popovertargetaction="hide" class={iconButton}>
          <span class="sr-only">{t(lang, 'nav.close')}</span>
          <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Voci grandi in Yankee Clipper, come un'insegna (scelta di Pietro, 2026-10-19).
         Misure verticali in svh: sui telefoni bassi, con le barre del browser, tutto il
         menu sta nello schermo; sugli schermi alti resta com'era (2026-10-29) -->
    <nav aria-label={t(lang, 'nav.label')} class="pt-[clamp(0.5rem,3svh,1.5rem)]">
      <ol>
        {
          pages.map(({ slug, key }, i) => (
            <li class="menu-item border-b-2 border-text" style={`--i: ${i}`}>
              <a
                href={`/${lang}/${slug}/`}
                aria-current={isCurrent(slug) ? 'page' : undefined}
                class="flex items-baseline gap-4 py-[clamp(0.375rem,1.2svh,0.75rem)] hover:text-red-text aria-[current=page]:text-red-text"
              >
                <span class="w-6 shrink-0 text-small text-red-text tabular-nums" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="font-sign text-[clamp(1.75rem,min(9vw,5svh),3rem)] leading-none uppercase">{t(lang, key)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="mt-auto flex flex-col items-start gap-[clamp(0.75rem,2.5svh,1.25rem)] pt-[clamp(1.5rem,5svh,2.5rem)] text-small">
      <OpenStatus lang={lang} />
      <Hours lang={lang} />
      <div class:list={['inline-flex', toolsClass]}>
        <LangSwitch lang={lang} short />
      </div>
    </div>
  </div>
</div>

{
  withDrawer && (
    <dialog
      data-cart-drawer
      aria-labelledby="cart-drawer-title"
      class="cart-drawer tone-sea m-0 ms-auto h-svh max-h-none w-full max-w-md border-0 border-s-3 border-text bg-bg p-0 text-text"
    >
      <!-- h-svh sul dialog, non h-dvh: alto quanto lo schermo con le barre del browser
           visibili, così su telefono "Afrekenen" non finisce sotto la barra (Pietro,
           2026-10-26). Lo stesso per il menu e l'avviso d'età -->
      <div class="flex h-full flex-col gap-4 p-6">
        <div class="flex items-center justify-between">
          <h2 id="cart-drawer-title" tabindex="-1" class="text-h2 leading-none focus:outline-none">{t(lang, 'cart.title')}</h2>
          <form method="dialog">
            <button class="inline-flex size-11 items-center justify-center">
              <span class="sr-only">{t(lang, 'cart.close')}</span>
              <svg class="size-6" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" />
              </svg>
            </button>
          </form>
        </div>
        <CartView lang={lang} variant="drawer" focusFallback="#cart-drawer-title" class="min-h-0 flex-1" />
      </div>
    </dialog>
  )
}

<style>
  /* La capsula sporge di 0.75rem oltre il contenuto, così logo e icone non cambiano
     posto quando compare. Ombra netta spostata, da adesivo */
  .capsule {
    inset-inline: calc(var(--page-x) - 0.75rem);
    box-shadow: 5px 5px 0 var(--text);
    opacity: 0;
    transform: scale(0.97);
  }

  [data-scrolled] .capsule {
    opacity: 1;
    transform: none;
  }

  /* Pillola rossa dietro il link: sulla pagina attiva e al passaggio. Se il mouse è
     su un altro link, la pillola della pagina attiva si spegne e si accende lì.
     Testo crema su rosso: 5.01:1 nel tema chiaro, 5.41:1 nello scuro */
  .nav-link {
    position: relative;
    isolation: isolate;
    transition: color 0.3s;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 9999px;
    background: var(--red-text);
    opacity: 0;
    transform: scale(0.6, 0.4);
    transition:
      opacity 0.25s,
      transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .nav-link:is(:hover, :focus-visible, [aria-current='page']) {
    color: var(--bg);
  }

  .nav-link:is(:hover, :focus-visible, [aria-current='page'])::before {
    opacity: 1;
    transform: none;
  }

  .nav-list:has(.nav-link:hover) .nav-link[aria-current='page']:not(:hover) {
    color: inherit;
  }

  .nav-list:has(.nav-link:hover) .nav-link[aria-current='page']:not(:hover)::before {
    opacity: 0;
    transform: scale(0.6, 0.4);
  }

  /* Il menu entra dall'alto, le voci arrivano di lato una dopo l'altra */
  @media (prefers-reduced-motion: no-preference) {
    .site-menu:popover-open {
      animation: menu-drop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .site-menu:popover-open .menu-item {
      animation: menu-item-in 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(0.15s + var(--i) * 0.12s);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::before {
      transition: none;
    }
  }

  @keyframes menu-drop {
    from {
      opacity: 0;
      transform: translateY(-1.5rem);
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateX(-3rem);
    }
  }
</style>

<script>
  import { countItems, loadCart, onCartChange, type Cart } from '../../lib/shop/cart';

  // Numero di articoli sull'icona del carrello, in ogni pagina e tra le schede
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  let shownCount = 0;
  const showCount = (cart: Cart) => {
    if (!badge) return;
    const count = countItems(cart);
    badge.hidden = count === 0;
    badge.textContent = count > 99 ? '99+' : String(count);
    // Il numero salta quando cresce (dopo il volo della foto, niente con movimento ridotto)
    if (count > shownCount && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      badge.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.7)' }, { transform: 'scale(1)' }], { duration: 550, delay: 850, easing: 'cubic-bezier(0.3, 1.6, 0.5, 1)' });
    }
    shownCount = count;
  };
  shownCount = countItems(loadCart());
  showCount(loadCart());
  onCartChange(showCount);

  // Pannello del carrello: il clic normale sull'icona lo apre al posto della pagina.
  // Ctrl/Cmd/Maiusc+clic restano al browser (nuova scheda). Esc e ✕ chiudono da soli
  // (<dialog> e form method="dialog"); il clic sullo sfondo lo chiude qui.
  const drawer = document.querySelector<HTMLDialogElement>('[data-cart-drawer]');
  const cartLink = document.querySelector<HTMLAnchorElement>('[data-cart-link]');
  if (drawer && cartLink) {
    cartLink.setAttribute('aria-haspopup', 'dialog');
    cartLink.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      drawer.showModal();
    });
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });
  }

  // Menu a tutto schermo (popover): mentre è aperto il resto della pagina è inert, così
  // Tab e lettori di schermo non finiscono sugli elementi nascosti dietro. beforetoggle
  // e non toggle: alla chiusura l'inert si toglie prima, e Esc riporta il focus sul
  // pulsante del menu. Senza JS il menu funziona lo stesso, senza questo blocco
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('beforetoggle', (event) => {
    const open = (event as ToggleEvent).newState === 'open';
    for (const element of document.body.children) {
      if (element !== menu && element instanceof HTMLElement) element.inert = open;
    }
  });
  // Aperto il menu, il focus va sul pulsante ✕: quello che l'ha aperto ora è inert
  menu?.addEventListener('toggle', (event) => {
    if ((event as ToggleEvent).newState === 'open') menu.querySelector<HTMLElement>('[popovertargetaction="hide"]')?.focus();
  });

  // Scorrendo, la fascia diventa capsula: si animano solo opacity e transform
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
