---
// Scheda di un prodotto nel catalogo: foto, nome, prezzo scritto in build da
// merch.ts, disponibilità aggiunta dal JS. Tutta la scheda è un link.
// Stile (docs/02): angoli arrotondati, etichette a pillola sulla foto, e al
// passaggio la scheda si solleva con un'ombra piena sfalsata, come un adesivo.
import { Image } from 'astro:assets';
import { skusOf } from '../../data/merch';
import type { Lang } from '../../i18n/locales';
import { formatPrice } from '../../lib/format';
import { productImage, swatch } from '../../lib/shop/images';
import type { MerchItem } from '../../lib/shop/types';
import { t, type Key } from '../../i18n/t';
import StockStatus from './StockStatus.astro';

interface Props {
  lang: Lang;
  item: MerchItem;
  // la prima scheda di ogni gruppo è più grande: niente file di schede uguali (docs/02)
  large?: boolean;
  class?: string;
}

const { lang, item, large = false, class: className } = Astro.props;
const name = t(lang, `shop.products.${item.slug}.name` as Key);
const skus = skusOf(item);
// Prodotti con colori: quadratini sotto il nome (Pietro, 2026-11-03). Sono dentro il
// link della scheda: senza JS portano alla scheda, col JS alla scheda con quel colore
const colors = item.colors ?? [];
const colorNames = colors.map((color) => t(lang, `shop.color.${color}` as Key));
---

<li data-card class={className}>
  <a
    href={`/${lang}/shop/${item.slug}/`}
    class="group flex h-full flex-col overflow-hidden rounded-2xl border-[1.5px] border-text bg-bg transition duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[6px_6px_0_var(--color-text)] motion-reduce:transition-none motion-reduce:hover:translate-x-0 motion-reduce:hover:translate-y-0"
  >
    <span class="relative block overflow-hidden border-b-[1.5px] border-text">
      <Image
        src={productImage(item.slug)}
        alt=""
        widths={large ? [480, 800] : [320, 480]}
        sizes={large ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, 50vw'}
        format="webp"
        loading="lazy"
        class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      />
      {
        item.limited !== null && (
          <span class="absolute top-3 left-3 rounded-full bg-neon-board px-3 py-1 text-small text-gold tabular-nums">
            <span aria-hidden="true">1/{item.limited}</span>
            <span class="sr-only">{t(lang, 'shop.limitedOf', { count: String(item.limited) })}</span>
          </span>
        )
      }
      <StockStatus lang={lang} skus={skus} class="absolute top-3 right-3 rounded-full bg-bg px-3 py-1 empty:hidden" />
    </span>
    <span class="flex flex-1 flex-wrap items-end justify-between gap-3 p-4">
      <span class:list={['card-title min-w-0 break-words hyphens-auto', colors.length > 0 && 'basis-full']}>{name}</span>
      {
        colors.length > 0 && (
          <span class="flex min-w-0 flex-wrap gap-1.5">
            <span class="sr-only">{t(lang, 'shop.colorLabel')}: {colorNames.join(', ')}</span>
            {colors.map((color, index) => (
              <span
                data-swatch={color}
                title={colorNames[index]}
                aria-hidden="true"
                class="size-4 rounded-[4px] border-[1.5px] border-text hover:outline-2 hover:outline-offset-2 hover:outline-text"
                style={`background-color: ${swatch(item.slug, color)}`}
              />
            ))}
          </span>
        )
      }
      <span class="shrink-0 rounded-full border-[1.5px] border-text px-3 py-1 text-small tabular-nums transition-colors group-hover:bg-text group-hover:text-bg">
        {formatPrice(item.priceCents, lang)}
      </span>
    </span>
  </a>
</li>

<script>
  // Clic su un quadratino del catalogo: la scheda si apre con quel colore già scelto
  // (AddToCart legge ?color=). Con Ctrl o Cmd resta il link normale, in un'altra scheda
  document.addEventListener('click', (event) => {
    const square = (event.target as Element).closest<HTMLElement>('[data-swatch]');
    const link = square?.closest('a');
    if (!square || !link || event.ctrlKey || event.metaKey || event.shiftKey) return;
    event.preventDefault();
    location.href = `${link.pathname}?color=${square.dataset.swatch}`;
  });
</script>
