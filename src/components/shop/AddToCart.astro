---
// Scelta di colore, taglia e quantità e aggiunta al carrello. Serve JS: senza, il
// modulo resta nascosto e c'è il messaggio <noscript>; colori e taglie restano
// scritti sopra. Il JS disattiva colori e taglie esauriti, non aggiunge più pezzi
// di quelli rimasti e, scegliendo un colore, mostra la sua foto (ProductGallery).
// Se non resta niente, il pulsante diventa "Esaurito", spento.
// Colori a quadratini con la tinta vera (Pietro, 2026-11-03; dal 2026-10-27 erano
// pastiglie col nome): il nome del colore scelto sta accanto a "Colore". Dal
// catalogo si arriva con ?color=… e quel colore è già scelto
import type { Lang } from '../../i18n/locales';
import { colorPhotoIndex, swatch } from '../../lib/shop/images';
import type { MerchItem } from '../../lib/shop/types';
import { t, type Key } from '../../i18n/t';

interface Props {
  lang: Lang;
  item: MerchItem;
}

const { lang, item } = Astro.props;
const colors = item.colors ?? [];
const quantities = Array.from({ length: 10 }, (_, i) => i + 1);
const pill =
  'inline-flex min-h-11 min-w-12 cursor-pointer items-center justify-center border-[1.5px] rounded-full border-text px-3 peer-checked:bg-text peer-checked:text-bg peer-disabled:cursor-not-allowed peer-disabled:border-muted peer-disabled:text-muted peer-disabled:line-through peer-focus-visible:outline-3 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-red';
// Quadratino da 44 px: quello scelto ha un anello staccato, uno esaurito è sbiadito e barrato
const square =
  'block size-11 cursor-pointer rounded-lg border-[1.5px] border-text peer-checked:shadow-[0_0_0_3px_var(--color-bg),0_0_0_5px_var(--color-text)] peer-disabled:cursor-not-allowed peer-disabled:opacity-40 peer-focus-visible:outline-3 peer-focus-visible:outline-offset-[7px] peer-focus-visible:outline-red';
const colorName = (color: string) => t(lang, `shop.color.${color}` as Key);
---

<add-to-cart
  data-slug={item.slug}
  data-too-many={t(lang, 'shop.tooMany')}
  data-sold-out={t(lang, 'shop.soldOut')}
  data-done={t(lang, 'shop.addedShort')}
>
  <form hidden class="space-y-6">
    {
      colors.length > 0 && (
        <fieldset>
          <legend class="mb-3 uppercase">
            {t(lang, 'shop.colorLabel')}
            <span aria-hidden="true">{' · '}<span data-color-name>{colorName(colors[0]!)}</span></span>
          </legend>
          <div class="flex flex-wrap gap-3">
            {colors.map((color, index) => (
              <label class="relative" title={colorName(color)}>
                <input type="radio" name="color" value={color} data-name={colorName(color)} data-photo={colorPhotoIndex(item.slug, color)} checked={index === 0} required class="peer sr-only" />
                <span class={square} style={`background-color: ${swatch(item.slug, color)}`}>
                  <span class="sr-only">{colorName(color)}</span>
                </span>
                <span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 hidden h-[1.5px] w-14 -translate-1/2 -rotate-45 bg-text peer-disabled:block"></span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }
    {
      item.sizes.length > 0 && (
        <fieldset>
          <legend class="mb-2 uppercase">{t(lang, 'shop.size')}</legend>
          <div class="flex flex-wrap gap-2">
            {item.sizes.map((size, index) => (
              <label class="relative">
                <input type="radio" name="size" value={size} checked={index === 0} required class="peer sr-only" />
                <span class={pill}>{size}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }

    <div class="flex flex-wrap items-end gap-4">
      <label class="flex flex-col gap-2">
        <span class="uppercase">{t(lang, 'shop.quantity')}</span>
        <select name="quantity" class="min-h-11 border-[1.5px] rounded-xl border-text bg-bg px-3">
          {quantities.map((n) => <option value={n}>{n}</option>)}
        </select>
      </label>
      <button type="submit" class="btn-solid disabled:cursor-not-allowed disabled:opacity-60">
        {t(lang, 'shop.addToCart')}
      </button>
    </div>

    <p data-message role="status" class="min-h-6"></p>
    <p data-added hidden>
      {t(lang, 'shop.added')}{' '}
      <a href={`/${lang}/shop/cart/`} class="inline-block py-2.5 underline decoration-red-text decoration-[3px] underline-offset-[6px]">{t(lang, 'shop.viewCart')}</a>
    </p>
  </form>
  <noscript><p class="border-[1.5px] rounded-2xl border-text px-4 py-3">{t(lang, 'shop.noscript')}</p></noscript>
</add-to-cart>

<script>
  import { skuOf } from '../../data/merch';
  import { addItem, loadCart, saveCart } from '../../lib/shop/cart';
  import { loadProducts } from '../../lib/shop/stock';
  import type { Color, Size } from '../../lib/shop/types';
  import { flyToCart } from '../../scripts/fly-to-cart';

  class AddToCart extends HTMLElement {
    #stock = new Map<string, number>();

    async connectedCallback() {
      const slug = this.dataset.slug!;
      const form = this.querySelector('form')!;
      const message = this.querySelector<HTMLElement>('[data-message]')!;
      const added = this.querySelector<HTMLElement>('[data-added]')!;
      const button = form.querySelector('button')!;
      const colors = [...form.querySelectorAll<HTMLInputElement>('input[name=color]')];
      const sizes = [...form.querySelectorAll<HTMLInputElement>('input[name=size]')];
      form.hidden = false;

      const checked = (radios: HTMLInputElement[]) => radios.find((radio) => radio.checked)?.value ?? null;
      const skuFor = (color: string | null, size: string | null) => skuOf(slug, size as Size | null, color as Color | null);
      // Prima del caricamento delle giacenze tutto è disponibile
      const available = (sku: string) => (this.#stock.get(sku) ?? 1) > 0;

      // Per il colore scelto: taglie esaurite non selezionabili; se quella scelta lo
      // è, passa alla prima libera
      const updateSizes = () => {
        const color = checked(colors);
        for (const radio of sizes) radio.disabled = !available(skuFor(color, radio.value));
        if (sizes.length > 0 && !sizes.some((radio) => radio.checked && !radio.disabled)) {
          const first = sizes.find((radio) => !radio.disabled);
          if (first) first.checked = true;
        }
      };

      const colorName = this.querySelector<HTMLElement>('[data-color-name]');
      for (const radio of colors) {
        radio.addEventListener('change', () => {
          updateSizes();
          if (colorName) colorName.textContent = radio.dataset.name ?? '';
          this.dispatchEvent(new CustomEvent('product-color', { bubbles: true, detail: { photo: Number(radio.dataset.photo) } }));
        });
      }

      // Arrivati dal catalogo con ?color=grey: quel colore è già scelto, con la sua foto
      const wanted = colors.find((radio) => radio.value === new URLSearchParams(location.search).get('color'));
      if (wanted && !wanted.checked) {
        wanted.checked = true;
        wanted.dispatchEvent(new Event('change'));
      }

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const sku = skuFor(checked(colors), checked(sizes));
        const quantity = Number(new FormData(form).get('quantity'));
        const inCart = loadCart().find((item) => item.sku === sku)?.quantity ?? 0;
        const stock = this.#stock.get(sku);
        added.hidden = true;
        // Il controllo vero lo fa il checkout; qui si evita solo di illudere
        if (stock !== undefined && inCart + quantity > stock) {
          message.textContent = (this.dataset.tooMany ?? '').replace('{count}', String(stock));
          return;
        }
        saveCart(addItem(loadCart(), sku, quantity));
        // La foto vola al carrello; il pulsante conferma per un momento
        flyToCart(document.querySelector<HTMLImageElement>('main img'));
        const label = button.textContent;
        button.textContent = '✓ ' + (this.dataset.done ?? '');
        setTimeout(() => (button.textContent = label), 1600);
        message.textContent = '';
        added.hidden = false;
      });

      const products = await loadProducts();
      if (!products) return;
      for (const variant of products.flatMap((product) => product.variants)) this.#stock.set(variant.sku, variant.stock);

      // Colori senza nessuna taglia disponibile non selezionabili
      const sizeValues = sizes.length > 0 ? sizes.map((radio) => radio.value) : [null];
      for (const radio of colors) radio.disabled = !sizeValues.some((size) => available(skuFor(radio.value, size)));
      if (colors.length > 0 && !colors.some((radio) => radio.checked && !radio.disabled)) {
        const first = colors.find((radio) => !radio.disabled);
        if (first) {
          first.checked = true;
          first.dispatchEvent(new Event('change'));
        }
      }
      updateSizes();

      // Niente di disponibile: il pulsante stesso dice "Esaurito" e non si clicca
      // (Pietro, 2026-11-03; prima restava "Aggiungi" spento con la scritta sotto)
      const colorValues = colors.length > 0 ? colors.map((radio) => radio.value) : [null];
      const soldOut = !colorValues.some((color) => sizeValues.some((size) => available(skuFor(color, size))));
      if (soldOut) {
        button.disabled = true;
        button.textContent = this.dataset.soldOut ?? '';
      }
    }
  }

  customElements.define('add-to-cart', AddToCart);
</script>
