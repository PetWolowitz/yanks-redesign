---
// Un campo del checkout: etichetta, input, suggerimento e posto per l'errore,
// collegati con aria-describedby. L'errore lo scrive il JS (validate.ts).
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email';
  autocomplete: string;
  hint?: string;
  maxlength?: number;
  class?: string;
}

const { name, label, type = 'text', autocomplete, hint, maxlength, class: className } = Astro.props;
const id = `checkout-${name}`;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class="uppercase">{label}</label>
  {hint && <p id={`${id}-hint`} class="text-small text-muted">{hint}</p>}
  <slot>
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      maxlength={maxlength}
      aria-describedby={describedBy}
      class="min-h-11 border-3 border-text bg-bg px-3 py-2 aria-[invalid=true]:border-red-text"
    />
  </slot>
  <p id={`${id}-error`} data-error-for={name} hidden class="text-small text-red-text"></p>
</div>
