---
// Anteprima dello shop: le due edizioni limitate, la maglietta 1/250 e la
// mystery box in 50 pezzi (docs/03: "meritano spazio proprio"), con le loro foto.
// Stesso linguaggio delle schede del catalogo: angoli arrotondati, numero
// dell'edizione su una pillola, ombra piena sfalsata al passaggio.
// Prezzi da merch.ts, scritti nell'HTML in build.
import { Image } from 'astro:assets';
import { merch } from '../../data/merch';
import type { Lang } from '../../i18n/locales';
import { formatPrice } from '../../lib/format';
import { productImage } from '../../lib/shop/images';
import { t, type Key } from '../../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const limited = merch.filter((item) => item.limited !== null);
---

<section class="edge-shadow border-t-3 border-text bg-surface">
  <div class="mx-auto max-w-360 px-page py-12 lg:py-16">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="text-h2 leading-none">{t(lang, 'nav.shop')}</h2>
        <p class="mt-6 max-w-[45ch] font-prose">{t(lang, 'home.shop.text')}</p>
      </div>
      <a
        href={`/${lang}/shop/`}
        class="inline-flex min-h-11 items-center rounded-full border-3 border-text px-5 py-2 uppercase transition-colors hover:bg-text hover:text-bg"
      >
        {t(lang, 'home.shop.link')}
      </a>
    </div>

    <ul class="mt-10 grid gap-6 lg:grid-cols-12">
      {
        limited.map((item, index) => {
          const name = t(lang, `shop.products.${item.slug}.name` as Key);
          return (
            <li data-card class={index === 0 ? 'lg:col-span-7' : 'lg:col-span-5'}>
              <a
                href={`/${lang}/shop/${item.slug}/`}
                class="group flex h-full flex-col overflow-hidden rounded-2xl border-3 border-text bg-bg transition duration-300 ease-out hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[6px_6px_0_var(--color-text)] motion-reduce:transition-none motion-reduce:hover:translate-x-0 motion-reduce:hover:translate-y-0"
              >
                <span class="relative block overflow-hidden border-b-3 border-text">
                  <Image
                    src={productImage(item.slug)}
                    alt=""
                    widths={[480, 800]}
                    sizes="(min-width: 1024px) 50vw, 100vw"
                    format="webp"
                    loading="lazy"
                    class="aspect-[16/10] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                  <span class="absolute bottom-4 left-4 rounded-full bg-neon-board px-5 py-2 font-sign text-h2 leading-none text-gold" aria-hidden="true">
                    1/{item.limited}
                  </span>
                </span>
                <span class="flex flex-1 flex-wrap items-end justify-between gap-4 p-5">
                  <span>
                    <span class="block font-sign text-h3 uppercase">{name}</span>
                    <span class="text-small text-muted">{t(lang, 'home.shop.pieces', { count: String(item.limited) })}</span>
                  </span>
                  <span class="rounded-full border-2 border-text px-4 py-1 tabular-nums transition-colors group-hover:bg-text group-hover:text-bg">
                    {formatPrice(item.priceCents, lang)}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
