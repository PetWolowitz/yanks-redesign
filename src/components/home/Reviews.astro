---
// Recensioni scritte, in lingua originale con lang giusto (docs/04). Niente stelle,
// niente voti: la fonte e il link (docs/03).
// Griglia a bento rovesciata rispetto a quella del club (Pietro, 2026-10-01): là la
// tessera alta è a destra e quella larga in alto, qui la tessera alta è a sinistra e
// quelle larghe in basso. Mobile first:
// - telefono: una colonna (titolo, recensioni, premio)
// - tablet: due colonne, la prima recensione alta quanto le due accanto
// - desktop: tre colonne, la prima recensione alta quanto tutta la griglia
// Ogni tessera entra con un movimento diverso (data-anim, global.css).
import { reviews } from '../../data/reviews';
import { venue } from '../../data/venue';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tile = 'rounded-2xl border-3 border-text';
// Posto e movimento delle prime tre recensioni; le altre, se arrivano, vanno in coda
const layout = [
  { place: 'sm:row-span-2 lg:col-start-1 lg:row-start-1 lg:row-span-3', anim: 'left' },
  { place: 'lg:col-span-2 lg:col-start-2 lg:row-start-2', anim: 'tilt' },
  { place: 'lg:col-start-3 lg:row-start-1', anim: 'right' },
];
---

<section class="edge-shadow border-t-3 border-text">
  <div class="mx-auto grid max-w-360 gap-4 px-page py-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6 lg:py-16">
    <div data-anim="down" class="flex flex-col justify-end sm:col-span-2 lg:col-span-1 lg:col-start-2 lg:row-start-1">
      <h2 class="text-h2 leading-none">{t(lang, 'home.reviews.title')}</h2>
      <p class="mt-4 text-small text-muted">{t(lang, 'home.reviews.note')}</p>
    </div>

    {
      reviews.map((review, index) => (
        <figure
          data-anim={layout[index]?.anim ?? 'up'}
          class:list={[tile, 'relative bg-surface p-6 pt-10 lg:p-8 lg:pt-12', layout[index]?.place]}
        >
          <svg class="absolute -top-5 left-6 size-10 text-red" viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="20" fill="var(--color-bg)" />
            <path d="M9 27v-6c0-5 3-9 8-10l1 3c-3 1-4 3-4 5h4v8zm13 0v-6c0-5 3-9 8-10l1 3c-3 1-4 3-4 5h4v8z" fill="currentColor" />
          </svg>
          <blockquote lang={review.lang} class:list={['font-prose', index === 0 && 'lg:text-[1.3rem] lg:leading-relaxed']}>
            <p>{review.text}</p>
          </blockquote>
          <figcaption class="mt-4 text-small text-muted">
            <a href={review.url} rel="noopener" class="underline underline-offset-4 hover:text-text">
              {t(lang, 'home.reviews.source')}
            </a>
            {review.excerpt && <span> · {t(lang, 'home.reviews.excerpt')}</span>}
          </figcaption>
        </figure>
      ))
    }

    <!-- Il premio su una tavola scura, come l'insegna dell'orologio: oro su nero -->
    <div
      data-anim="zoom"
      class:list={[tile, 'flex flex-wrap items-baseline justify-between gap-4 bg-neon-board p-6 text-gold sm:col-span-2 lg:col-start-2 lg:row-start-3 lg:p-8']}
    >
      <p class="max-w-[40ch] font-sign text-h3 uppercase">{t(lang, 'home.reviews.award')}</p>
      <a href={venue.maps.url} rel="noopener" class="inline-block py-2 underline underline-offset-4">{t(lang, 'home.reviews.all')}</a>
    </div>
  </div>
</section>
