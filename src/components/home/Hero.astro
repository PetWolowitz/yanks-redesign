---
// Hero della home. Il segno forte è il logo originale, grande e isolato (docs/02).
// A sinistra il nome, centrato come un'insegna, a destra il logo.
// Sfondo (CLAUDE.md, Video): la spiaggia di Zandvoort. Il fotogramma fisso (poster)
// c'è sempre, il video solo su schermi larghi (LoopVideo.astro). Sopra, un velo
// nel colore dello sfondo tiene il contrasto del testo in tutti e due i temi.
// Il logo è in alta risoluzione (Logo.astro): qui è il segno forte, grande.
import poster from '../../assets/home/hero-spiaggia.jpg';
import Hours from '../site/Hours.astro';
import LoopVideo from '../site/LoopVideo.astro';
import Logo from '../site/Logo.astro';
import { venue } from '../../data/venue';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { open, close } = venue.hours;
---

<section class="relative isolate overflow-hidden">
  <LoopVideo src="/video/hero-spiaggia.webm" poster={poster} alt="" widths={[960, 1920]} sizes="100vw" priority class="-z-20" />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-bg/85 lg:bg-transparent lg:bg-linear-to-r lg:from-bg/90 lg:via-bg/80 lg:to-bg/30"></div>

  <div class="mx-auto grid max-w-360 items-center gap-10 px-page py-10 lg:grid-cols-12 lg:gap-6 lg:py-16">
    <div class="lg:col-span-7">
      <!-- Il blocco del nome, centrato come un'insegna: Yanks, la riga e l'anno -->
      <div class="text-center">
        <h1 class="text-display text-red">Yanks</h1>
        <p class="mt-4 font-sign text-h2 leading-none text-matte uppercase">{venue.tagline}</p>
        {venue.founded && <p class="mt-4 text-small tracking-[0.35em] text-muted uppercase">{t(lang, 'home.since', { year: String(venue.founded) })}</p>}
      </div>
      <p class="mt-8 max-w-[45ch] font-prose text-h3 leading-snug">{t(lang, 'home.intro', { open, close })}</p>
      <div class="mt-8 flex flex-wrap items-end gap-x-10 gap-y-6">
        <Hours lang={lang} />
        <a
          href={`/${lang}/visit/`}
          class="inline-flex min-h-11 items-center border-3 rounded-full border-text bg-text px-5 py-2 text-bg uppercase hover:bg-bg hover:text-text"
        >
          {t(lang, 'home.planVisit')}
        </a>
      </div>
    </div>
    <div class="order-first lg:order-none lg:col-span-5 lg:justify-self-end">
      <Logo alt={venue.name} variant="badge" size={448} priority class="size-56 sm:size-80 lg:size-[28rem]" />
    </div>
  </div>
</section>

