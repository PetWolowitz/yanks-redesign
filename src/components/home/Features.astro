---
// Chi sono e le tre cose che contano: terrazza, orario, spiaggia (docs/04).
// Asimmetrico: la foto della terrazza grande a sinistra, due blocchi di testo
// a destra. Mai tre schede uguali in fila (docs/02).
import { Image } from 'astro:assets';
import interno from '../../assets/home/interno.jpg';
import terras from '../../assets/home/terras.png';
import { venue } from '../../data/venue';
import type { Lang } from '../../i18n/locales';
import { t } from '../../i18n/t';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { close, dineInUntil } = venue.hours;
---

<section class="border-t-3 border-text">
  <div class="mx-auto max-w-360 px-4 py-12 lg:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-7">
        <h2 class="text-h2 leading-none">{t(lang, 'home.about.title')}</h2>
        <p class="mt-6 max-w-[65ch] font-prose">{t(lang, 'home.about.text')}</p>
      </div>
      <!-- Foto dell'interno da shop.yanks.nl: 720 px, quindi mai più larga -->
      <Image
        src={interno}
        alt={t(lang, 'home.interior.alt')}
        widths={[360, 720]}
        sizes="(min-width: 1024px) 400px, 100vw"
        format="webp"
        loading="lazy"
        class="w-full max-w-100 border-3 rounded-2xl border-text lg:col-span-5 lg:justify-self-end"
      />
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-6">
      <figure class="lg:col-span-7 lg:row-span-2">
        <Image
          src={terras}
          alt={t(lang, 'home.terrace.alt')}
          widths={[390, 640]}
          sizes="(min-width: 1024px) 640px, 100vw"
          format="webp"
          loading="lazy"
          class="h-auto w-full rounded-2xl border-3 border-text lg:max-w-160"
        />
        <figcaption class="mt-4">
          <h3 class="text-h3">{t(lang, 'home.terrace.title')}</h3>
          <p class="mt-2 max-w-[50ch] font-prose">{t(lang, 'home.terrace.text')}</p>
        </figcaption>
      </figure>

      <div data-card class="rounded-2xl border-3 border-text bg-surface p-6 lg:col-span-5 lg:self-start lg:p-8">
        <h3 class="text-h3">{t(lang, 'home.late.title')}</h3>
        <p class="mt-2 font-prose">{t(lang, 'home.late.text', { close, dineInUntil })}</p>
      </div>

      <div data-card class="rounded-2xl border-3 border-text bg-surface p-6 lg:col-span-5 lg:self-start lg:p-8">
        <h3 class="text-h3">{t(lang, 'home.beach.title')}</h3>
        <p class="mt-2 font-prose">{t(lang, 'home.beach.text')}</p>
      </div>
    </div>
  </div>
</section>
