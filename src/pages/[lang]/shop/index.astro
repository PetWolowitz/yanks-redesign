---
// Catalogo (docs/04, Fase 2S): edizioni numerate in evidenza, poi i prodotti per
// categoria. Prezzi scritti nell'HTML in build da merch.ts; il JS aggiunge solo
// la disponibilità. Senza JS il catalogo si legge tutto (CLAUDE.md, shop).
import type { GetStaticPaths } from 'astro';
import ProductCard from '../../../components/shop/ProductCard.astro';
import PageIntro from '../../../components/site/PageIntro.astro';
import { merch } from '../../../data/merch';
import { venue } from '../../../data/venue';
import Base from '../../../layouts/Base.astro';
import { langPaths, type Lang } from '../../../i18n/locales';
import type { Category } from '../../../lib/shop/types';
import { t, type Key } from '../../../i18n/t';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const limited = merch.filter((item) => item.limited !== null);
const categories: Category[] = ['clothing', 'smoking'];
const byCategory = (category: Category) => merch.filter((item) => item.category === category && item.limited === null);
---

<Base lang={lang} title={`${t(lang, 'nav.shop')} · ${venue.name}`} description={t(lang, 'shop.description')}>
  <main id="content">
    <PageIntro title={t(lang, 'nav.shop')} intro={t(lang, 'shop.intro')}>
      <p class="mt-4 text-small text-muted">{t(lang, 'shop.testMode')}</p>
      <noscript><p class="mt-4 border-3 border-text px-4 py-3">{t(lang, 'shop.noscript')}</p></noscript>
    </PageIntro>

    <section class="mx-auto max-w-360 px-4 pb-12">
      <h2 class="border-t-3 border-text pt-6 text-h2 leading-none">{t(lang, 'shop.limited.title')}</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {limited.map((item) => <ProductCard lang={lang} item={item} large />)}
      </ul>
    </section>

    {
      categories.map((category) => (
        <section class="mx-auto max-w-360 px-4 pb-12">
          <h2 class="border-t-3 border-text pt-6 text-h2 leading-none">{t(lang, `shop.category.${category}` as Key)}</h2>
          <ul class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
            {byCategory(category).map((item, index) => (
              <ProductCard lang={lang} item={item} large={index === 0} class={index === 0 ? 'col-span-2 row-span-2' : undefined} />
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>
