---
// Pagina ordine (CLAUDE.md, contratto dello shop). Il success_url di Stripe porta
// qui senza parametri: id e token si leggono da sessionStorage (li salva il
// checkout) oppure dal fragment #id=…&t=… del link nell'email. Poi getOrder.
// - pending: "pagamento in verifica" e nuovi controlli per qualche secondo
// - secondo paracadute: il link completo, selezionabile, con "Copia link"
// - token sbagliato e ordine inesistente hanno la stessa risposta
import type { GetStaticPaths } from 'astro';
import PageIntro from '../../../components/site/PageIntro.astro';
import { venue } from '../../../data/venue';
import Base from '../../../layouts/Base.astro';
import { langPaths, type Lang } from '../../../i18n/locales';
import { buildCatalog } from '../../../lib/shop/catalog';
import { t } from '../../../i18n/t';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const catalog = await buildCatalog(lang);
const messages = {
  pending: t(lang, 'order.pending'),
  pendingLong: t(lang, 'order.pendingLong'),
  paid: t(lang, 'order.paid'),
  shipped: t(lang, 'order.shipped'),
  cancelled: t(lang, 'order.cancelled'),
  missing: t(lang, 'order.missing'),
  notFound: t(lang, 'order.notFound'),
  unavailable: t(lang, 'shop.unavailable'),
  copied: t(lang, 'order.link.copied'),
  copyFailed: t(lang, 'order.link.copyFailed'),
};
---

<Base lang={lang} title={`${t(lang, 'order.title')} · ${venue.name}`} description={t(lang, 'order.description')}>
  <main id="content">
    <PageIntro title={t(lang, 'order.title')} intro={t(lang, 'shop.testMode')} />

    <order-status
      class="mx-auto block max-w-360 px-4 pb-12"
      data-lang={lang}
      data-catalog={JSON.stringify(catalog)}
      data-messages={JSON.stringify(messages)}
    >
      <p data-message role="status" class="border-t-3 border-text pt-6 font-prose text-h3">{t(lang, 'order.loading')}</p>
      <noscript><p class="mt-6 border-3 rounded-2xl border-text px-4 py-3">{t(lang, 'shop.noscript')}</p></noscript>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-6">
        <section data-details hidden class="border-3 rounded-2xl border-text p-6 lg:col-span-7">
          <h2 class="text-h3">{t(lang, 'order.number')} <span data-id class="font-ui text-small normal-case"></span></h2>
          <ul data-lines class="mt-4"></ul>
          <p class="mt-4 flex items-baseline justify-between gap-4 text-h3">
            <span>{t(lang, 'order.total')}</span>
            <span data-total class="tabular-nums"></span>
          </p>
        </section>

        <section data-link-box hidden class="h-fit border-3 rounded-2xl border-text p-6 lg:col-span-5">
          <h2 class="text-h3">{t(lang, 'order.link.title')}</h2>
          <p class="mt-2 text-small">{t(lang, 'order.link.text')}</p>
          <code data-link class="mt-4 block border-2 rounded-2xl border-muted bg-surface p-3 text-small break-all select-all"></code>
          <button type="button" data-copy class="mt-4 min-h-11 border-3 rounded-full border-text px-4 py-2 uppercase hover:bg-text hover:text-bg">
            {t(lang, 'order.link.copy')}
          </button>
          <p data-copy-status role="status" class="mt-2 min-h-6 text-small"></p>
        </section>
      </div>
    </order-status>
  </main>
</Base>

<script>
  import type { Lang } from '../../../i18n/locales';
  import { formatPrice } from '../../../lib/format';
  import { shopApi } from '../../../lib/shop/api';
  import { saveCart } from '../../../lib/shop/cart';
  import type { CatalogEntry } from '../../../lib/shop/catalog';
  import { orderLink, parseOrderFragment, parseStoredAccess, type OrderAccess } from '../../../lib/shop/order-link';
  import { ShopError, type OrderStatus } from '../../../lib/shop/types';

  const ORDER_KEY = 'yanks-order';
  const CLEARED_KEY = 'yanks-cart-cleared-for';
  // Il webhook può arrivare dopo il cliente: si ricontrolla per circa 30 secondi
  const RETRY_MS = 2000;
  const MAX_TRIES = 15;

  function storage(): Storage | null {
    try {
      return sessionStorage;
    } catch {
      return null;
    }
  }

  class OrderStatusView extends HTMLElement {
    #messages: Record<string, string> = {};
    #catalog: Record<string, CatalogEntry> = {};

    connectedCallback() {
      this.#messages = JSON.parse(this.dataset.messages ?? '{}');
      this.#catalog = JSON.parse(this.dataset.catalog ?? '{}');

      const fromSession = parseStoredAccess(storage()?.getItem(ORDER_KEY) ?? null);
      const fromLink = parseOrderFragment(location.hash);
      const access = fromLink ?? fromSession;
      if (!access) return this.say(this.#messages.missing!);

      // Aperta dal link dell'email: lo si ricorda per i ricaricamenti di questa scheda
      if (fromLink) storage()?.setItem(ORDER_KEY, JSON.stringify(fromLink));
      this.showLink(access);
      void this.check(access, 1, !fromLink);
    }

    say(text: string) {
      this.querySelector('[data-message]')!.textContent = text;
    }

    async check(access: OrderAccess, attempt: number, justPaid: boolean) {
      let order: OrderStatus;
      try {
        order = await shopApi.getOrder(access.id, access.token);
      } catch (error) {
        const notFound = error instanceof ShopError && error.code === 'not_found';
        return this.say(notFound ? this.#messages.notFound! : this.#messages.unavailable!);
      }

      this.showDetails(order);
      if (order.status === 'pending') {
        if (attempt >= MAX_TRIES) return this.say(this.#messages.pendingLong!);
        this.say(this.#messages.pending!);
        setTimeout(() => void this.check(access, attempt + 1, justPaid), RETRY_MS);
        return;
      }
      this.say(this.#messages[order.status]!);

      // Pagato appena ora in questa scheda: il carrello si svuota, una volta sola
      if (order.status === 'paid' && justPaid && storage()?.getItem(CLEARED_KEY) !== order.id) {
        saveCart([]);
        storage()?.setItem(CLEARED_KEY, order.id);
      }
    }

    showDetails(order: OrderStatus) {
      const lang = this.dataset.lang as Lang;
      this.querySelector<HTMLElement>('[data-details]')!.hidden = false;
      this.querySelector('[data-id]')!.textContent = order.id.slice(0, 8);
      this.querySelector('[data-lines]')!.replaceChildren(
        ...order.items.map((item) => {
          const entry = this.#catalog[item.sku];
          const li = document.createElement('li');
          li.className = 'flex items-baseline gap-4 border-b border-muted py-2';
          li.append(`${item.quantity} × ${entry ? `${entry.name}${entry.size ? ` (${entry.size})` : ''}` : item.sku}`);
          const price = document.createElement('span');
          price.className = 'ms-auto tabular-nums whitespace-nowrap';
          // Prezzi dell'ordine, come li ha registrati il server
          price.textContent = formatPrice(item.priceCents * item.quantity, lang);
          li.append(price);
          return li;
        }),
      );
      this.querySelector('[data-total]')!.textContent = formatPrice(order.totalCents, lang);
    }

    showLink(access: OrderAccess) {
      const link = orderLink(location.origin, this.dataset.lang ?? 'en', access);
      this.querySelector<HTMLElement>('[data-link-box]')!.hidden = false;
      this.querySelector('[data-link]')!.textContent = link;
      const status = this.querySelector('[data-copy-status]')!;
      this.querySelector('[data-copy]')!.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(link);
          status.textContent = this.#messages.copied!;
        } catch {
          status.textContent = this.#messages.copyFailed!;
        }
      });
    }
  }

  customElements.define('order-status', OrderStatusView);
</script>
