---
// Carrello (docs/04, Fase 2S). Le righe le disegna CartView, lo stesso del pannello
// laterale. Il subtotale è indicativo: l'addebito lo calcola sempre il server (docs/06).
import type { GetStaticPaths } from 'astro';
import CartView from '../../../components/shop/CartView.astro';
import PageIntro from '../../../components/site/PageIntro.astro';
import { venue } from '../../../data/venue';
import Base from '../../../layouts/Base.astro';
import { langPaths, type Lang } from '../../../i18n/locales';
import { t } from '../../../i18n/t';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
---

<Base lang={lang} title={`${t(lang, 'cart.title')} · ${venue.name}`} description={t(lang, 'cart.description')}>
  <main id="content">
    <PageIntro title={t(lang, 'cart.title')} intro={t(lang, 'shop.testMode')}>
      <noscript><p class="mt-6 rounded-2xl border-3 border-text px-4 py-3">{t(lang, 'shop.noscript')}</p></noscript>
    </PageIntro>

    <CartView lang={lang} variant="page" focusFallback="main h1" class="mx-auto max-w-360 px-page pb-12" />
  </main>
</Base>
