---
// Menu (CLAUDE.md): food e drink, bibite raggruppate per marca, prezzo unico una volta.
// Solo cibo e bevande, niente cannabis (docs/03). I "filtri" sono salti ai gruppi:
// link interni, funzionano senza JS. Prezzi DA VERIFICARE (null) non si mostrano:
// al loro posto il rimando al cartellone dei prezzi, che esiste davvero.
import type { GetStaticPaths } from 'astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { menu } from '../../data/menu';
import { venue } from '../../data/venue';
import Base from '../../layouts/Base.astro';
import { langPaths, type Lang } from '../../i18n/locales';
import { formatPrice } from '../../lib/format';
import { t, type Key } from '../../i18n/t';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const groupTitle = (id: string) => t(lang, `menu.group.${id}` as Key);
const itemName = (id: string) => t(lang, `menu.item.${id}` as Key);
---

<Base lang={lang} title={`${t(lang, 'nav.menu')} · ${venue.name}`} description={t(lang, 'menu.description')}>
  <main id="content">
    <PageIntro title={t(lang, 'nav.menu')} intro={t(lang, 'menu.intro')}>
      <nav aria-label={t(lang, 'menu.jump')} class="mt-8">
        <ul class="flex flex-wrap gap-3">
          {
            menu.map((group) => (
              <li>
                <a href={`#${group.id}`} class="inline-flex min-h-11 items-center border-3 rounded-full border-text px-4 text-small uppercase hover:bg-text hover:text-bg">
                  {groupTitle(group.id)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </PageIntro>

    <div class="mx-auto grid max-w-360 gap-x-6 gap-y-12 px-page pb-12 lg:grid-cols-12">
      {
        menu.map((group, index) => (
          <section id={group.id} class:list={['edge-shadow scroll-mt-32 border-t-3 border-text pt-6', index % 2 === 0 ? 'lg:col-span-7' : 'lg:col-span-5']}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h2 class="text-h2 leading-none">{groupTitle(group.id)}</h2>
              {group.kind === 'drinks' && group.priceCents !== null && (
                <p class="border-3 rounded-2xl border-text px-3 py-1 uppercase tabular-nums">
                  {t(lang, 'menu.allPrice', { price: formatPrice(group.priceCents, lang) })}
                </p>
              )}
            </div>

            {group.kind === 'items' ? (
              <ul class="mt-6">
                {group.items.map((item) => (
                  <li class="flex items-baseline gap-4 border-b border-muted py-2">
                    <span>{itemName(item.id)}</span>
                    {item.priceCents !== null && <span class="ms-auto whitespace-nowrap tabular-nums">{formatPrice(item.priceCents, lang)}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <ul class="mt-6 grid gap-x-6 sm:grid-cols-2">
                {group.drinks.map((drink) => (
                  <li class="flex items-baseline gap-4 border-b border-muted py-2">
                    <span>{'brand' in drink ? drink.brand : itemName(drink.id)}</span>
                    {'brand' in drink && drink.variants && (
                      <span class="ms-auto text-small whitespace-nowrap text-muted">{t(lang, 'menu.variants', { count: String(drink.variants) })}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}

            {(group.kind === 'items' ? group.items.some((item) => item.priceCents === null) : group.priceCents === null) && (
              <p class="mt-4 text-small text-muted">{t(lang, 'menu.priceOnBoard')}</p>
            )}
          </section>
        ))
      }
    </div>
  </main>
</Base>
