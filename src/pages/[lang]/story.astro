---
// Story (CLAUDE.md, Struttura delle pagine): una cronologia breve, solo fatti
// verificati (docs/03). Il testo originale di our-story è promozionale e non si usa.
// Gli anni vengono da venue.ts: se cambiano lì, cambia anche questa pagina.
// Dal 2026-10-22 la cronologia è una griglia a bento (Pietro: lo scorrimento di
// lato non piaceva), mobile first, in ordine di tempo da sinistra a destra e
// dall'alto in basso:
// - telefono: una colonna
// - tablet: due colonne, le due tappe con foto a tutta larghezza
// - desktop: tre colonne, l'insegna alta quanto tutta la griglia a destra e
//   "oggi" largo due colonne sotto le prime due tappe
// Ogni tessera entra con un movimento diverso (data-anim, global.css).
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import interno from '../../assets/home/interno.jpg';
import capBack from '../../assets/shop/cap/3.jpg';
import PageIntro from '../../components/site/PageIntro.astro';
import { venue } from '../../data/venue';
import Base from '../../layouts/Base.astro';
import { langPaths, type Lang } from '../../i18n/locales';
import { t, type Key } from '../../i18n/t';

export const getStaticPaths = langPaths satisfies GetStaticPaths;

const { lang } = Astro.props as { lang: Lang };
const { open, close } = venue.hours;
const year = String(venue.founded ?? '');

// Le tre forme delle tessere: solo testo, alta con la foto sopra, larga con la foto a lato
type Shape = 'text' | 'tall' | 'wide';
const shapes: Record<Shape, { tile: string; article: string; photo: string; body: string; sizes: string }> = {
  text: { tile: '', article: '', photo: '', body: 'flex-1', sizes: '' },
  tall: {
    tile: 'sm:col-span-2 lg:col-span-1 lg:col-start-3 lg:row-span-2 lg:row-start-1',
    article: '',
    photo: 'aspect-3/2 border-b-[1.5px] lg:aspect-auto lg:min-h-64 lg:flex-1',
    body: 'lg:flex-none',
    sizes: '(min-width: 1024px) 440px, 100vw',
  },
  wide: {
    tile: 'sm:col-span-2 lg:col-start-1 lg:row-start-2',
    article: 'sm:flex-row',
    photo: 'aspect-3/2 border-b-[1.5px] sm:aspect-auto sm:min-h-72 sm:w-1/2 sm:border-r-[1.5px] sm:border-b-0',
    body: 'flex-1',
    sizes: '(min-width: 1024px) 440px, (min-width: 640px) 50vw, 100vw',
  },
};

// Ogni tappa: l'anno (o un'etichetta se l'anno non si sa), titolo, testo, foto facoltativa
const steps: {
  when: string;
  // gli anni in grande, le etichette ("Vandaag") alla misura dei titoli: in grande non ci stanno
  isYear?: boolean;
  title: Key;
  text: Key;
  params?: Record<string, string>;
  image?: { src: ImageMetadata; alt: Key };
  shape: Shape;
  anim: string;
}[] = [
  ...(venue.founded
    ? [{ when: year, isYear: true, title: 'story.opened.title', text: 'story.opened.text', shape: 'text', anim: 'left' } as const]
    : []),
  { when: String(venue.companyFounded), isYear: true, title: 'story.company.title', text: 'story.company.text', shape: 'text', anim: 'down' },
  {
    when: t(lang, 'story.sign.label'),
    title: 'story.sign.title',
    text: 'story.sign.text',
    image: { src: capBack, alt: 'story.sign.alt' },
    shape: 'tall',
    anim: 'right',
  },
  {
    when: t(lang, 'story.today.label'),
    title: 'story.today.title',
    text: 'story.today.text',
    params: { open, close },
    image: { src: interno, alt: 'home.interior.alt' },
    shape: 'wide',
    anim: 'tilt',
  },
];
---

<Base
  lang={lang}
  title={`${t(lang, 'story.title')} · ${venue.name}`}
  description={t(lang, 'story.description', { year })}
>
  <main id="content">
    <PageIntro title={t(lang, 'story.title')} intro={t(lang, 'story.intro', { year })} />

    <ol
      aria-label={t(lang, 'story.title')}
      class="mx-auto grid max-w-360 gap-4 px-page pb-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6"
    >
      {
        steps.map((step) => {
          const shape = shapes[step.shape];
          return (
            <li data-anim={step.anim} class:list={['flex', shape.tile]}>
              <article class:list={['flex w-full flex-col overflow-hidden rounded-2xl border-[1.5px] border-text bg-surface', shape.article]}>
                {step.image && (
                  <div class:list={['relative shrink-0 border-text', shape.photo]}>
                    <Image
                      src={step.image.src}
                      alt={t(lang, step.image.alt)}
                      widths={[360, 667]}
                      sizes={shape.sizes}
                      format="webp"
                      loading="lazy"
                      class="absolute inset-0 size-full object-cover"
                    />
                  </div>
                )}
                <div class:list={['flex flex-col p-6 lg:p-8', shape.body]}>
                  <p class:list={['font-sign leading-none text-red-text uppercase', step.isYear ? 'text-display' : 'text-h2']}>
                    {step.when}
                  </p>
                  <h2 class="mt-4 text-h2 leading-none">{t(lang, step.title)}</h2>
                  <p class="mt-4 max-w-[55ch] font-prose">{t(lang, step.text, step.params)}</p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <div class="mx-auto max-w-360 px-page pb-16">
      <a
        href={`/${lang}/visit/`}
        class="btn"
      >
        {t(lang, 'story.cta')} →
      </a>
    </div>
  </main>
</Base>
