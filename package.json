{
  "name": "yanks-redesign",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "verify": "astro check && astro build && vitest run",
    "astro": "astro",
    "db:migrate:local": "wrangler d1 migrations apply yanks-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply yanks-db --remote",
    "db:seed:local": "node scripts/seed.ts && wrangler d1 execute yanks-db --local --file=.wrangler/seed.sql",
    "db:seed:remote": "node scripts/seed.ts && wrangler d1 execute yanks-db --remote --file=.wrangler/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.145.0"
  }
}
